{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bd >/dev/null 2>&1 && bd memories || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bd >/dev/null 2>&1 && bd memories || true"
          }
        ]
      }
    ]
  }
}
